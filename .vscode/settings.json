{
    "python.REPL.enableREPLSmartSend": false,
    "python.languageServer": "Pylance",
    "python.analysis.autoImportCompletions": true,
    "python.analysis.languageServerMode": "full",
    "qtForPython.qmlls.path": "D:\\Project\\Cairn\\.venv\\Lib\\site-packages\\PySide6\\qmlls.exe",
    "python.analysis.autoFormatStrings": true,
    "python.analysis.autoTranslateDocstrings": true,
    "python.analysis.completeFunctionParens": true,
    "python.analysis.diagnosticsSource": "Pylance",
    "python.testing.pytestEnabled": true,
    "python.testing.unittestEnabled": false,
    "python.testing.pytestArgs": [
        "tests"
    ],
    "[python]": {
        "editor.defaultFormatter": "charliermarsh.ruff",
        "editor.codeActionsOnSave": {
            "source.fixAll.ruff": "explicit",
            "source.organizeImports.ruff": "explicit"
        },
        "editor.tabSize": 4,
        "editor.insertSpaces": true,
        "editor.detectIndentation": false,
        "files.trimTrailingWhitespace": true,
        "files.insertFinalNewline": true
    },
    "files.trimFinalNewlines": true,
    "files.exclude": {
        "**/__pycache__": true,
        "**/*.egg-info": true,
        "**/.mypy_cache": true,
        "**/.ruff_cache": true,
        "**/.pytest_cache": true,
        "**/.coverage": true,
        "**/htmlcov": true,
        "vault": true
    },
    "search.exclude": {
        ".venv": true,
        "vault": true,
        "build": true,
        "dist": true,
        ".mypy_cache": true,
        ".ruff_cache": true,
        ".pytest_cache": true
    },
    "editor.inlineSuggest.enabled": false,
    "files.autoSave": "afterDelay",
    "python.analysis.aiCodeActions": {
        "generateDocstring": true,
        "convertLambdaToNamedFunction": true,
        "implementAbstractClasses": true,
        "generateSymbol": true,
        "convertFormatString": true
    },
    "python.analysis.enableTroubleshootMissingImports": true,
    "python.analysis.generateWithTypeAnnotation": true,
    "python.analysis.inlayHints.functionReturnTypes": true,
    "python.analysis.inlayHints.pytestParameters": true,
    "files.autoSaveDelay": 500,
    "files.autoSaveWhenNoErrors": false,
    "files.autoSaveWorkspaceFilesOnly": true,
    "files.insertFinalNewline": true,
    "files.simpleDialog.enable": true,
    "python.terminal.activateEnvironment": false
}
