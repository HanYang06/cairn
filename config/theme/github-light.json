{
  "$schema": "../../schema/theme.json",
  "name": "github-light",
  "dark": false,
  "token": {
    "bg": "#FFFFFF",
    "chrome": "#F6F8FA",
    "surface": "#FFFFFF",
    "elevated": "#FFFFFF",
    "border": "#D0D7DE",
    "border_strong": "#AFB8C1",
    "border_faint": "#E6EAEF",
    "text": "#1F2328",
    "muted": "#656D76",
    "faint": "#6E7781",
    "accent": "#0969DA",
    "accent_alt": "#1A7F37",
    "accent_text": "#FFFFFF",
    "selection": "#DDF4FF",
    "hover": "#F3F4F6",
    "danger": "#CF222E",
    "shadow_color": "#14000000"
  },
  "style": {
    "widget.TitleBar": { "background": "token.chrome" },
    "widget.StatusBar": { "background": "token.chrome" },
    "widget.NavigatorPanel": { "background": "token.surface" },
    "widget.InspectorPanel": { "background": "token.surface" },
    "widget.TabBar": { "background": "token.bg" },
    "widget.FormatToolbar": { "background": "token.bg" }
  }
}
